<odoo>

    <record model="ir.ui.view" id="automation_configuration_form_view">
        <field name="model">automation.configuration</field>
        <field
            name="inherit_id"
            ref="automation_oca.automation_configuration_form_view"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='automation_step_ids']/kanban//button[hasclass('o_automation_kanban_header_icon')]"
                position="inside"
            >
                <span
                    class="fa fa-pencil-square-o"
                    t-if="record.step_type.raw_value == 'sign'"
                    title="Sign"
                    role="img"
                    aria-label="Sign"
                />
            </xpath>
        </field>
    </record>

        <record model="ir.ui.view" id="automation_configuration_step_form_view">
        <field name="model">automation.configuration.step</field>
        <field
            name="inherit_id"
            ref="automation_oca.automation_configuration_step_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='step_type']/../.." position="inside">

                <group attrs="{'invisible':[('step_type', '!=', 'sign')]}">
                    <field
                        name="sign_template_id"
                        attrs="{'required': [('step_type', '=', 'sign')]}"
                    />
                    <field
                        name="sign_signer_partner_field_id"
                        domain="[('model_id', '=', model_id), ('relation', '=',  'res.partner')]"
                        attrs="{'required': [('step_type', '=', 'sign')]}"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
